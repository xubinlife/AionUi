{
  "version": 1,
  "provider": {
    "id": "computing-platform",
    "platform": "custom",
    "name": "计算平台模型服务",
    "base_url": "https://server-v3.computingplatform.com/api/v1/openai/v1",
    "models": ["qwen3.6-35b-a3b-fp8"],
    "enabled": true,
    "is_full_url": false
  },
  "mcp": {
    "name": "computing-platform",
    "description": "计算平台 MCP 服务，用于查询和操作任务、资源、数据集、模型、工单及用户上下文。",
    "url": "https://mcp.computingplatform.com/mcp",
    "enabled": false,
    "headers": {
      "Authorization": ""
    }
  },
  "skills": {
    "enabled": false,
    "name_prefix": "computing-platform-",
    "update": {
      "enabled": true,
      "manifest_url": "https://mirrors.computingplatform.com/repository/files/software/AionUi/skills/latest.yml",
      "download_url_template": "https://mirrors.computingplatform.com/repository/files/software/AionUi/skills/SKILL-{version}.zip",
      "timeout_ms": 10000,
      "max_download_bytes": 67108864,
      "require_sha512": false
    }
  },
  "assistant": {
    "id": "computing-platform-assistant",
    "name": "计算平台助手",
    "description": "面向计算平台的一站式智能助手，可通过自然语言查询任务与资源、分析运行故障、管理数据集与模型，并辅助完成任务创建和平台操作。",
    "avatar": "🖥️",
    "enabled": false,
    "agent_id": "aionrs",
    "default_model": "qwen3.6-35b-a3b-fp8",
    "recommended_prompts": [
      "查看我最近的计算任务和运行状态",
      "分析我最近失败的任务并给出处理建议",
      "查看当前 GPU 资源和配额使用情况",
      "查询我的数据集和模型",
      "帮我根据现有配置创建一个计算任务",
      "查看当前团队和账号信息",
      "查看我的工单并总结需要处理的事项"
    ],
    "rules_file": "assistant-rules.md"
  }
}
